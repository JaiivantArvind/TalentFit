# ===================================================================
# TalentFit AI - Unified Environment Configuration Template
# ===================================================================

# -------------------------------------------------------------------
# Backend Configuration (Place in backend/.env)
# -------------------------------------------------------------------

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
# Required for text-embedding-004 and gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project URL & Key (https://supabase.com/dashboard)
# Required for user JWT verification and cloud settings sync
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Resend Email API Key (https://resend.com/api-keys)
# Required for recruitment outreach email dispatch
RESEND_API_KEY=your_resend_api_key_here

# Backend Server Port (Defaults to 5000)
PORT=5000

# -------------------------------------------------------------------
# Frontend Configuration (Place in Frontend/.env)
# -------------------------------------------------------------------

# Supabase Project URL & Anon Public Key (client-side auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Backend API Endpoint URL (Defaults to http://127.0.0.1:5000 for local dev)
VITE_API_URL=http://127.0.0.1:5000
